<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="12dp" android:background="@drawable/larenest_widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/larenest_mark" android:contentDescription="Larenest" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="7dp"
            android:textColor="#E3A848" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A8A29B" android:textSize="11sp" android:maxLines="1" />
        <TextView android:id="@+id/w_refresh" android:layout_width="34dp" android:layout_height="30dp" android:gravity="center" android:text="⟳" android:textColor="#E08A66"
            android:textSize="18sp" android:contentDescription="Refresh" />
    </LinearLayout>
    <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#ECEBE8" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
    <TextView android:id="@+id/w_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#A8A29B" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
    <ImageView android:id="@+id/w_chart" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:layout_marginEnd="6dp" android:scaleType="fitXY" android:contentDescription="30-day change" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_c7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_c30" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
