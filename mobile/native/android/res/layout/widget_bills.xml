<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingTop="10dp" android:paddingBottom="12dp" android:background="@drawable/larenest_widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/larenest_mark" android:contentDescription="Larenest" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="7dp"
            android:textColor="#E3A848" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A8A29B" android:textSize="11sp" android:maxLines="1" />
        <TextView android:id="@+id/w_refresh" android:layout_width="34dp" android:layout_height="30dp" android:gravity="center" android:text="⟳" android:textColor="#E08A66"
            android:textSize="18sp" android:contentDescription="Refresh" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#ECEBE8" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
        <TextView android:id="@+id/w_bigsub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#A8A29B" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <ImageView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:layout_marginEnd="6dp" android:src="@drawable/larenest_widget_divider" />
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#A8A29B" android:textSize="12sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="6dp">
            <TextView android:id="@+id/w_r1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#ECEBE8" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            <TextView android:id="@+id/w_v1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="6dp">
            <TextView android:id="@+id/w_r2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#ECEBE8" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            <TextView android:id="@+id/w_v2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="6dp">
            <TextView android:id="@+id/w_r3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#ECEBE8" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            <TextView android:id="@+id/w_v3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="6dp">
            <TextView android:id="@+id/w_r4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#ECEBE8" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            <TextView android:id="@+id/w_v4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingEnd="6dp">
            <TextView android:id="@+id/w_r5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#ECEBE8" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            <TextView android:id="@+id/w_v5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
